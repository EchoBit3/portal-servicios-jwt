# Variables de entorno de la API (Proyecto 1)
# Copiar a .env y ajustar antes de desplegar. Ninguna clave se guarda en el repositorio.

# Obligatoria cuando DJANGO_DEBUG=0. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 = desarrollo local, 0 = producción
DJANGO_DEBUG=1
# Hosts permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Ruta del archivo SQLite (opcional; por defecto <proyecto>/db.sqlite3)
DJANGO_DB_PATH=

# Duración de los tokens JWT
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_DIAS=1

# Límites de peticiones (formato DRF: cantidad/periodo)
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=10/min
API_PAGE_SIZE=20

# Documentación OpenAPI
API_TITULO=API de Gestión de Usuarios y Permisos
API_VERSION=1.0.0

# Contraseñas de los usuarios de demostración (solo para seed_demo).
# Si no se define, el comando exige definirlas y no crea usuarios.
SEED_ADMIN_PASSWORD=
SEED_JUAN_PASSWORD=
SEED_MARIA_PASSWORD=
