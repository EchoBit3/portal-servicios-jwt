# Variables de entorno del portal (Proyecto 2)
# Copiar a .env y ajustar antes de desplegar. Ninguna clave se guarda en el repositorio.

# Obligatoria cuando DJANGO_DEBUG=0. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PORTAL_SECRET_KEY=
# 1 = desarrollo local, 0 = producción
DJANGO_DEBUG=1
# Hosts permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# URL base de la API del Proyecto 1
API_BASE_URL=http://127.0.0.1:8000/api
API_TIMEOUT=5

# Cookie de sesión firmada
PORTAL_COOKIE_NOMBRE=portal_sesion
PORTAL_COOKIE_MINUTOS=30
# Marcar en 1 solo si el portal se publica por HTTPS
PORTAL_COOKIE_SECURE=0
